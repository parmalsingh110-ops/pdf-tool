{
  "name": "mediasuite-pdf-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "backend": "./backend/venv/bin/uvicorn main:app --app-dir backend --host 0.0.0.0 --port 8000 --reload",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:extension": "rm -f pdf-media-suite-extension.zip public/pdf-media-suite-extension.zip && cd extension && zip -r ../pdf-media-suite-extension.zip . -x '*.DS_Store*' -x 'README.md' -x 'store-assets*' && cp ../pdf-media-suite-extension.zip ../public/pdf-media-suite-extension.zip"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tensorflow-models/body-segmentation": "^1.0.2",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@types/html2canvas": "^0.5.35",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.3.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "docx": "^9.15.4",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "harfbuzzjs": "^1.6.4",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "modern-gif": "^2.1.0",
    "motion": "^12.43.0",
    "pdf-lib": "^1.17.1",
    "pdf-lib-plus-encrypt": "^1.1.0",
    "pdfjs-dist": "^6.5.438",
    "peerjs": "^1.5.5",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-draggable": "^4.7.2",
    "react-dropzone": "^15.0.0",
    "react-router-dom": "^7.18.5",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "regenerator-runtime": "^0.13.11",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "utif": "^3.1.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "zgapdfsigner": "^2.8.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.19.17",
    "@types/react-dom": "^19.3.0",
    "@types/react-signature-canvas": "^1.0.7",
    "autoprefixer": "^10.6.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^8.3.8"
  }
}
