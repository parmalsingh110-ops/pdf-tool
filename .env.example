# PDF Media Suite — Environment Variables Reference
# ====================================================
# DO NOT commit real secrets. This file documents what env vars to set.
# For production: set these in Render → Environment tab (Secret Files / Env Vars)
# For local dev:  copy to .env and fill in values (git will ignore .env)

# ── Server-Side Hybrid OCR (iLovePDF + Local OCRmyPDF Fallback) ─
# Set ALLOW_EXTERNAL_ILOVEPDF_OCR=true (default) to use server-side iLovePDF API
# for English OCR (keys stay strictly server-side, never bundled in frontend) with
# automatic local OCRmyPDF fallback, or set false / use strict_local=true for 100% local OCR.
ALLOW_EXTERNAL_ILOVEPDF_OCR=true
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=

# ── Admin Dashboard Secret & Privacy Salt (REQUIRED FOR /admin) ──
# Set a strong random secret for Admin Dashboard login and IP hash salting:
ADMIN_SECRET_KEY=replace_with_strong_random_secret_at_least_16_chars
IP_HASH_SALT=replace_with_random_32byte_hex_salt

# ── CORS Configuration ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default includes production + localhost for dev.
ALLOWED_ORIGINS=https://www.pdfmediasuite.in,https://pdfmediasuite.in,http://localhost:3000,http://localhost:4173

# ── Upload & Processing Limits ──────────────────────────────────
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300
MAX_DPI=300
MAX_PROCESSING_SECONDS=300
MAX_CONCURRENT_LIBREOFFICE=2

# ── Telemetry & Error Alerting (Discord / Telegram) ────────────
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_FEEDBACK_WEBHOOK_URL=your_discord_feedback_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── API Documentation ────────────────────────────────────────────
# Set to 'true' only in development/staging. Keep 'false' in production.
ENABLE_DOCS=false

# ── Frontend Variables (compiled into browser JS bundle) ─────────
# VITE_ prefix = visible to anyone who opens DevTools → Sources.
# NEVER put private API keys (Gemini / OpenAI / iLovePDF) in VITE_* variables!
VITE_API_URL=https://your-backend-name.onrender.com
