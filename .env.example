# PDF Media Suite — Environment Variables Reference
# ====================================================
# DO NOT commit real secrets. This file documents what env vars to set.
# For production (Render): set backend env vars in Render → Environment tab.
# For local dev:
#   - Root `.env`:        ONLY `VITE_API_URL=http://localhost:8000` (public frontend URL)
#   - `backend/.env`:     ALL server-side API keys (NEVER sent to or visible in browser/console)

# ── Server-Side Hybrid OCR (iLovePDF + Local OCRmyPDF Fallback) ─
# Set ALLOW_EXTERNAL_ILOVEPDF_OCR=true (default) to use server-side iLovePDF API
# for English OCR (keys stay strictly server-side, never bundled in frontend) with
# automatic local OCRmyPDF fallback, or set false / use strict_local=true for 100% local OCR.
ALLOW_EXTERNAL_ILOVEPDF_OCR=true
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=

# ── Server-Side Vision AI Boost (Gemini / Claude / OpenAI) ───────
# Paste keys ONLY in backend/.env (NEVER prefix with VITE_!).
# Runs strictly backend -> AI provider via HTTPS headers (never in URL/browser/console).
ALLOW_AI_VISION_OCR=true
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── AI spend protection (server key only; user-supplied keys are never throttled) ──
# AI_DAILY_CALL_LIMIT : max paid upstream AI calls per UTC day across ALL users (default 600).
# AI_PER_IP_DAILY     : max AI-enabled requests per visitor per day on your key (default 25).
# When a limit is hit the app silently continues with the local OCR/table engines (no error).
AI_DAILY_CALL_LIMIT=600
AI_PER_IP_DAILY=25

# ── Admin Dashboard Secret & Privacy Salt (REQUIRED FOR /admin) ──
# Set a strong random secret for Admin Dashboard login and IP hash salting:
ADMIN_SECRET_KEY=replace_with_strong_random_secret_at_least_16_chars
IP_HASH_SALT=replace_with_random_32byte_hex_salt

# ── CORS Configuration ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default includes production + localhost for dev.
ALLOWED_ORIGINS=https://www.pdfmediasuite.in,https://pdfmediasuite.in,http://localhost:3000,http://localhost:4173

# ── Upload & Processing Limits ──────────────────────────────────
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300
MAX_DPI=300
MAX_PROCESSING_SECONDS=300
MAX_CONCURRENT_LIBREOFFICE=2

# ── Multi-Lane Priority Load Balancer & Virtual Waiting Room ────
# Isolates fast UI analysis calls from heavy Office/OCR conversions so server never OOMs.
LANE_FAST_CONCURRENCY=12
LANE_MEDIUM_CONCURRENCY=4
LANE_HEAVY_CONCURRENCY=2
MAX_VIRTUAL_QUEUE_DEPTH=45
MAX_PER_IP_ACTIVE_JOBS=6
QUEUE_WAIT_TIMEOUT_SEC=55.0

# ── Decompression Bomb & Archive Safety Limits ──────────────────
MAX_ZIP_UNCOMPRESSED_MB=180
MAX_ZIP_COMPRESSION_RATIO=85.0
MAX_ZIP_ENTRIES=2500
RESULT_CACHE_MAX_ITEMS=48
RESULT_CACHE_MAX_MB=24
RESULT_CACHE_TTL_SEC=180.0

# ── Telemetry & Error Alerting (Discord / Telegram) ────────────
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_FEEDBACK_WEBHOOK_URL=your_discord_feedback_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── API Documentation ────────────────────────────────────────────
# Set to 'true' only in development/staging. Keep 'false' in production.
ENABLE_DOCS=false

# ── Frontend Variables (compiled into browser JS bundle) ─────────
# VITE_ prefix = visible to anyone who opens DevTools → Sources.
# NEVER put private API keys (Gemini / OpenAI / iLovePDF) in VITE_* variables!
# Supports a single URL or comma-separated pool for client-side load balancing & failover:
VITE_API_URL=https://your-backend-name.onrender.com
# VITE_API_POOL_URLS=https://node1.onrender.com,https://node2.onrender.com
