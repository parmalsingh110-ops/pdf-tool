{
  "manifest_version": 3,
  "name": "PDF Media Suite — 110+ Free PDF & Image Tools",
  "short_name": "PDF Media Suite",
  "version": "1.0.0",
  "description": "All-in-one PDF & Image Toolsuite. Compress, Merge, Convert PDF to Word/Excel, Sarkari Photo Sheet, Scan & Edit in 1-Click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PDF Media Suite — 110+ Free Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/search*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "https://www.pdfmediasuite.in/*",
    "https://pdfmediasuite.in/*",
    "http://localhost:8000/*"
  ]
}

