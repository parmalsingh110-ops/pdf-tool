{
  "manifest_version": 3,
  "name": "PDF Media Suite — 130+ Free Tools",
  "short_name": "PDF Media Suite",
  "version": "2.2.0",
  "description": "130+ free PDF & photo tools. Scan to Print QR, Target Compress (KB/MB), Passport sheets, Clean signature, Merge & Convert.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PDF Media Suite — 130+ Free Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/search*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open PDF Media Suite"
    }
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "tabs"
  ]
}
